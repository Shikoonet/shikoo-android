  "updateDownloading": "Downloading…",
  "updateProgress": "{percent}%, {done} of {total} MB",
  "@updateProgress": {"placeholders": {"percent": {"type": "int", "format": "decimalPattern"}, "done": {"type": "int", "format": "decimalPattern"}, "total": {"type": "int", "format": "decimalPattern"}}},
  "updateReady": "Ready to install",
  "updateInstall": "Install",
  "updateClosesApp": "Installing closes ShikooNet, and the connection if you're connected; open it again afterwards.",
  "@updateClosesApp": {"description": "On the ready card, the forced page and the install-permission dialog."},

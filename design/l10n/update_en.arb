  "updateNoSpaceHelp": "Remove a few apps or files from this device and try again.",
  "updateInstallFailed": "The installer didn't open; try again or ask Support.",
  "@updateInstallFailed": {"description": "One red line when Android's installer did not open: under Install on the card, above the buttons on the forced page. Not a new state; the next Install clears it."},
  "settingsCore": "Core",
  "settingsCoreHelp": "Updates together with the app.",
  "settingsCheckUpdate": "Check for updates",
  "settingsChecking": "Checking…",
  "settingsUpToDate": "You have the latest version.",
  "settingsCheckFailed": "Couldn't check; check your internet and try again.",
  "@settingsCoreHelp": {"description": "Under \"Core\" in Settings › App, whose value is the FlClash version (e.g. FlClash 0.8.99) from a constant in lib/shikoo/ that the upstream sync script writes when it merges a new tag. There is no separate core download."},
  "@settingsCheckUpdate": {"description": "Settings › App row: checks now, bypassing the 6-hour cap of the automatic check. When an update is known, this row is replaced by the same update card as Home."},
  "@settingsCheckFailed": {"description": "Red line under settingsCheckUpdate; tapping the row again retries. When the check was refused for this device's clock, the red line is clockWrongTitle followed by clockWrongHelp, and a plain settings row dateSettings with the gear icon follows, before About."}

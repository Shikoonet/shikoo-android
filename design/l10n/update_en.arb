  "updateDownloadFailedHelp": "Check your internet and try again; it picks up where it stopped.",
  "updateBadFileTitle": "The file arrived damaged.",
  "@updateBadFileTitle": {"description": "The finished file did not match the published sha256; it is deleted and the next try starts over."},
  "updateBadFileHelp": "Try again to download it from the start.",
  "updateForcedTitle": "This version needs an update",
  "@updateForcedTitle": {"description": "Full-screen page replacing Home when this install is below min_version_code. Its one button is updateGet. After a failed download or a damaged file it shows the matching error with two buttons: retry (focused on TV) and Support, aimed like every other Support (on TV the QR dialog). Ready to install shows Install and Support side by side, always. When the download was refused for this device's clock: clockWrongTitle and clockWrongHelp in the red message, then dateSettings (primary, focused on TV), retry and Support."},
  "updateForcedBody": "To keep using ShikooNet, download and install version {version} ({size} MB).",
  "@updateForcedBody": {"placeholders": {"version": {"type": "String", "example": "1.0.57"}, "size": {"type": "int", "format": "decimalPattern"}}},
  "installPermissionTitle": "Allow installing",
  "@installPermissionTitle": {"description": "Dialog before Android’s “install unknown apps” page, only when the permission is missing. Buttons: cancelButton and continueButton."},
  "installPermissionTouch": "On the next screen, turn on installing for “ShikooNet”, then press your phone’s Back button; the install starts by itself.",
  "installPermissionTv": "On the next screen, turn on installing for “ShikooNet”, then press Back on the remote; the install starts by itself.",
  "updateNoSpaceTitle": "Not enough space.",

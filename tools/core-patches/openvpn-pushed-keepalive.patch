+// ShikooKeepalive is the client's ping and ping-restart: the configured ones, else the server's pushed ones (OpenVPN
+// itself lets the pushed ones win). Without them a UDP session the server dropped is never noticed.
+func (c ClientConfig) ShikooKeepalive(push *PushReply) (ping, restart time.Duration) {
+	ping, restart = c.PingInterval, c.PingRestart
+	if push != nil {
+		if ping == 0 {
+			ping = push.PingInterval
+		}
+		if restart == 0 {
+			restart = push.PingRestart
+		}
+	}
+	return ping, restart
+}
+
 // DataCipherKeyLength returns the key size for the negotiated data cipher.
 func (c ClientConfig) DataCipherKeyLength() int {
 	return CipherKeyLength(c.Cipher)

diff --git a/transport/openvpn/shikoo_keepalive_test.go b/transport/openvpn/shikoo_keepalive_test.go
new file mode 100644
index 0000000..68f7ff0
--- /dev/null
+++ b/transport/openvpn/shikoo_keepalive_test.go
@@ -0,0 +1,35 @@
+package openvpn
+
+import (
+	"testing"
+	"time"
+)
+
+func TestShikooAPingFromAnEarlierSegmentSurvivesTheMerge(t *testing.T) {
+	first, err := parsePushReplyInner("PUSH_REPLY,ping 10,ping-restart 60,push-continuation 2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	last, err := parsePushReplyInner("PUSH_REPLY,ifconfig 10.8.3.2 255.255.255.0,push-continuation 1")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	merged := mergePushReply(first, last)
+
+	if merged.PingInterval != 10*time.Second || merged.PingRestart != 60*time.Second {
+		t.Fatalf("merged ping %s and ping-restart %s, want 10s and 60s from the first segment",
+			merged.PingInterval, merged.PingRestart)
+	}
+}
+
+func TestShikooAPushedKeepaliveIsCappedAtADay(t *testing.T) {
+	reply, err := ParsePushReply("PUSH_REPLY,ping 9999999999,ping-restart 100000000,ifconfig 10.8.3.2 255.255.255.0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reply.PingInterval != 24*time.Hour || reply.PingRestart != 24*time.Hour {
+		t.Fatalf("got ping %s and ping-restart %s, want both capped at 24h, not overflowed", reply.PingInterval,
+			reply.PingRestart)
+	}
+}

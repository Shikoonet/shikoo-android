+// ShikooRebind gives a WireGuard outbound's bind a new socket, through the dialer and so through VPN protect.
+// core/shikoo_rebind.go calls it once the VPN is up, for the sockets pings opened before it.
+func ShikooRebind(adapter C.ProxyAdapter) {
+	if p, ok := adapter.(*autoCloseProxyAdapter); ok {
+		adapter = p.ProxyAdapter
+	}
+	if w, ok := adapter.(*WireGuard); ok && w.initOk.Load() {
+		_ = w.device.IpcSet("listen_port=0\n")
+	}
+}

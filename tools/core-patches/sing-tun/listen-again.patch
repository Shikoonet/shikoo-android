+// listenAgain replaces a listener that failed while the stack is open, on the same address and port, so tunLoop's
+// tcpPort still holds. Android's netd destroys every socket on an address the kernel deleted, this listener too:
+// Accept then fails with EINVAL, and every TCP connection the NAT sends to the port is refused.
+func (s *System) listenAgain(network string, listener net.Listener, acceptErr error) net.Listener {
+	if errors.Is(acceptErr, net.ErrClosed) {
+		return nil
+	}
+	address := listener.Addr().String()
+	_ = listener.Close()
+	s.logger.Warn(E.Cause(acceptErr, "tcp listener ", address, " died, listening again"))
+	var err error
+	for attempt := 1; attempt <= 10; attempt++ {
+		var next net.Listener
+		next, err = s.listenConfig.Listen(s.ctx, network, address)
+		s.listenAccess.Lock()
+		if s.closed {
+			s.listenAccess.Unlock()
+			if err == nil {
+				_ = next.Close()
+			}
+			return nil
+		}
+		if err == nil {
+			if network == "tcp4" {
+				s.tcpListener = next
+			} else {
+				s.tcpListener6 = next
+			}
+			s.listenAccess.Unlock()
+			return next
+		}
+		s.listenAccess.Unlock()
+		time.Sleep(time.Duration(attempt) * 100 * time.Millisecond)
+	}
+	s.logger.Error(E.Cause(err, "tcp listener ", address, " is gone"))
+	return nil
+}

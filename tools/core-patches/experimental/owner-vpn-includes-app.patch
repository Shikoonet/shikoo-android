+// An owner core's VPN holds this app too: its own sockets are protected while no mihomo TUN is up.
+var ownerHandler atomic.Pointer[TunHandler]
+
+//export setOwnerProtector
+func setOwnerProtector(callback unsafe.Pointer) {
+	var next *TunHandler
+	if callback != nil {
+		next = &TunHandler{callback: callback, owner: true}
+		installHooks()
+	}
+	if previous := ownerHandler.Swap(next); previous != nil {
+		previous.close()
+	}
+}
+
+func protectOwnerSocket(fd int) error {
+	if th := ownerHandler.Load(); th != nil {
+		return th.handleProtect(fd)
+	}
+	return nil
+}

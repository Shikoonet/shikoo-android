diff --git a/core/shikoo_wg_android.go b/core/shikoo_wg_android.go
index f99a6c03..185397d8 100644
--- a/core/shikoo_wg_android.go
+++ b/core/shikoo_wg_android.go
@@ -2,7 +2,28 @@
 
 package main
 
+import wgconn "golang.zx2c4.com/wireguard/conn"
+
+type protectedBind struct{ *wgconn.StdNetBind }
+
+func (b protectedBind) Open(port uint16) ([]wgconn.ReceiveFunc, uint16, error) {
+	fns, actual, err := b.StdNetBind.Open(port)
+	if err != nil {
+		return fns, actual, err
+	}
+	for _, peek := range []func() (int, error){b.PeekLookAtSocketFd4, b.PeekLookAtSocketFd6} {
+		if fd, err := peek(); err == nil {
+			if err := protectOwnerSocket(fd); err != nil {
+				_ = b.StdNetBind.Close()
+				return nil, 0, err
+			}
+		}
+	}
+	return fns, actual, nil
+}
+
 // Windows registers its own "wireguard" owner: a name registered twice panics.
 func init() {
 	registerOwner("wireguard")
+	newOwnerBind = func() wgconn.Bind { return protectedBind{wgconn.NewStdNetBind().(*wgconn.StdNetBind)} }
 }

+
+type Credentials = (Vec<u8>, Vec<u8>);
+
+/// AETHER_PROXY_AUTH=user:pass makes every listener ask its clients for that password, socks5 by
+/// RFC 1929 and the http proxy by Basic: on Android every app can reach 127.0.0.1.
+fn proxy_auth() -> Option<&'static Credentials> {
+    static AUTH: std::sync::OnceLock<Option<Credentials>> = std::sync::OnceLock::new();
+    AUTH.get_or_init(|| {
+        let value = std::env::var("AETHER_PROXY_AUTH").ok()?;
+        let (user, password) = value.split_once(':')?;
+        Some((user.as_bytes().to_vec(), password.as_bytes().to_vec()))
+    })
+    .as_ref()
+}
+
+fn same(a: &[u8], b: &[u8]) -> bool {
+    a.len() == b.len() && a.iter().zip(b).fold(0, |d, (x, y)| d | (x ^ y)) == 0
+}
